{
  "name": "dungeon-designer",
  "productName": "Dungeon Designer",
  "description": "Tile based map editor.",
  "keywords": [],
  "main": "./main.js",
  "version": "1.0.0",
  "author": "Daniel Marshall",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.danielmarshall.dungeon-designer",
    "files": [
      "**/*",
      "!test/**",
      "!.claude/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "Assets/dungeondesignericon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "Assets/dungeondesignericon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "Assets/dungeondesignericon.png"
    }
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^24.13.3"
  }
}
